FROM registry.lazycat.cloud/x/lzc-aipod-vllm:d59c2ca AS vllm_runtime
FROM registry.lazycat.cloud/x/lzc-aipod-onnx:f503fe0 AS onnx_runtime
FROM registry.lazycat.cloud/x/lzc-aipod-cuda:2a9aebc

SHELL ["/bin/bash", "-lc"]

ARG UV_INDEX_URL=http://wa.lan:10608/simple
ARG UV_TRUSTED_HOST=wa.lan

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    NLTK_DATA=/usr/local/share/nltk_data \
    GPT_SOVITS_RUNTIME_DIR=/workspace/runtime \
    GPT_SOVITS_MODEL_ID=gpt-sovits-v2proplus-jetson \
    GPT_SOVITS_MAX_CONCURRENT=1 \
    GPT_SOVITS_MAX_QUEUE=16 \
    GPT_SOVITS_ENABLE_G2PW=auto \
    GPT_SOVITS_REQUIRE_ONNX_GPU=true \
    GPT_SOVITS_ONNX_INTRA_OP_THREADS=1 \
    GPT_SOVITS_ONNX_INTER_OP_THREADS=1 \
    GPT_SOVITS_TORCH_NUM_THREADS=1 \
    GPT_SOVITS_TORCH_INTEROP_THREADS=1 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    TOKENIZERS_PARALLELISM=false

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ffmpeg \
    git \
    libsox-dev \
    python3-pip \
    sox \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/GPT-SoVITS

COPY requirements.txt requirements-test.txt /workspace/GPT-SoVITS/
COPY --from=vllm_runtime /usr/local/lib/python3.10/dist-packages/torch /usr/local/lib/python3.10/dist-packages/torch
COPY --from=vllm_runtime /usr/local/lib/python3.10/dist-packages/torch-2.10.0.dist-info /usr/local/lib/python3.10/dist-packages/torch-2.10.0.dist-info
COPY --from=vllm_runtime /usr/local/lib/python3.10/dist-packages/functorch /usr/local/lib/python3.10/dist-packages/functorch
COPY --from=vllm_runtime /usr/local/lib/python3.10/dist-packages/torchgen /usr/local/lib/python3.10/dist-packages/torchgen
COPY --from=vllm_runtime /usr/local/lib/python3.10/dist-packages/torchvision /usr/local/lib/python3.10/dist-packages/torchvision
COPY --from=vllm_runtime /usr/local/lib/python3.10/dist-packages/torchvision-0.25.0.dist-info /usr/local/lib/python3.10/dist-packages/torchvision-0.25.0.dist-info
COPY --from=vllm_runtime /usr/local/lib/python3.10/dist-packages/triton /usr/local/lib/python3.10/dist-packages/triton
COPY --from=vllm_runtime /usr/local/lib/python3.10/dist-packages/triton-3.5.1.dist-info /usr/local/lib/python3.10/dist-packages/triton-3.5.1.dist-info
COPY --from=onnx_runtime /usr/local/lib/python3.10/dist-packages/onnxruntime /usr/local/lib/python3.10/dist-packages/onnxruntime
COPY --from=onnx_runtime /usr/local/lib/python3.10/dist-packages/onnxruntime_gpu-1.24.3.dist-info /usr/local/lib/python3.10/dist-packages/onnxruntime_gpu-1.24.3.dist-info

RUN grep -Ev '^(pyopenjtalk|onnxruntime|onnxruntime-gpu|torch|torchvision|torchaudio|triton)($|[;=<> ])' requirements.txt > requirements.jetson.txt

RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install \
      --no-deps "torchaudio==2.10.0" "numpy<2" flatbuffers \
      -i "${UV_INDEX_URL}" --trusted-host "${UV_TRUSTED_HOST}" && \
    python3 -m pip install \
      -r requirements.jetson.txt \
      -i "${UV_INDEX_URL}" --trusted-host "${UV_TRUSTED_HOST}" && \
    python3 -m pip install \
      -r requirements-test.txt \
      -i "${UV_INDEX_URL}" --trusted-host "${UV_TRUSTED_HOST}"

COPY . /workspace/GPT-SoVITS
COPY jetson/models/pretrained_models /workspace/GPT-SoVITS/GPT_SoVITS/pretrained_models
COPY jetson/models/G2PWModel /workspace/GPT-SoVITS/GPT_SoVITS/text/G2PWModel
COPY jetson/models/nltk_data /usr/local/share/nltk_data

RUN chmod +x /workspace/GPT-SoVITS/scripts/jetson/entrypoint.sh && \
    mkdir -p /workspace/runtime /workspace/test-results

EXPOSE 9880

ENTRYPOINT ["/workspace/GPT-SoVITS/scripts/jetson/entrypoint.sh"]
CMD ["python3", "api_v2.py", "-a", "0.0.0.0", "-p", "9880"]
