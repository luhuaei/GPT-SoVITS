FROM registry.lazycat.cloud/x/lzc-aipod-onnx:f503fe0 AS onnx_runtime
FROM registry.lazycat.cloud/x/lzc-aipod-vllm:d59c2ca

SHELL ["/bin/bash", "-lc"]

ARG UV_INDEX_URL=http://wa.lan:10608/simple
ARG UV_TRUSTED_HOST=wa.lan

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    NLTK_DATA=/usr/local/share/nltk_data \
    GPT_SOVITS_RUNTIME_DIR=/workspace/runtime \
    GPT_SOVITS_MODEL_ID=gpt-sovits-v2proplus-jetson \
    GPT_SOVITS_MAX_CONCURRENT=1 \
    GPT_SOVITS_MAX_QUEUE=16 \
    GPT_SOVITS_ENABLE_G2PW=auto \
    GPT_SOVITS_REQUIRE_ONNX_GPU=true \
    GPT_SOVITS_ONNX_INTRA_OP_THREADS=1 \
    GPT_SOVITS_ONNX_INTER_OP_THREADS=1 \
    GPT_SOVITS_TORCH_NUM_THREADS=1 \
    GPT_SOVITS_TORCH_INTEROP_THREADS=1 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    TOKENIZERS_PARALLELISM=false

RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake \
    libsox-dev \
    python3-pip \
    sox \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/GPT-SoVITS

COPY requirements.txt requirements-test.txt /workspace/GPT-SoVITS/
COPY --from=onnx_runtime /usr/local/lib/python3.10/dist-packages/onnxruntime /usr/local/lib/python3.10/dist-packages/onnxruntime
COPY --from=onnx_runtime /usr/local/lib/python3.10/dist-packages/onnxruntime_gpu-1.24.3.dist-info /usr/local/lib/python3.10/dist-packages/onnxruntime_gpu-1.24.3.dist-info

RUN grep -Ev '^(pyopenjtalk|onnxruntime|onnxruntime-gpu|torch|torchvision|torchaudio|triton)($|[;=<> ])' requirements.txt > requirements.jetson.txt

RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install \
      --no-deps "torchaudio==2.10.0" "numpy<2" flatbuffers \
      -i "${UV_INDEX_URL}" --trusted-host "${UV_TRUSTED_HOST}" && \
    python3 -m pip install \
      -r requirements.jetson.txt \
      -i "${UV_INDEX_URL}" --trusted-host "${UV_TRUSTED_HOST}" && \
    python3 -m pip install \
      -r requirements-test.txt \
      -i "${UV_INDEX_URL}" --trusted-host "${UV_TRUSTED_HOST}"

COPY . /workspace/GPT-SoVITS
COPY jetson/models/pretrained_models/chinese-hubert-base /workspace/GPT-SoVITS/GPT_SoVITS/pretrained_models/chinese-hubert-base
COPY jetson/models/pretrained_models/chinese-roberta-wwm-ext-large /workspace/GPT-SoVITS/GPT_SoVITS/pretrained_models/chinese-roberta-wwm-ext-large
COPY jetson/models/pretrained_models/fast_langdetect /workspace/GPT-SoVITS/GPT_SoVITS/pretrained_models/fast_langdetect
COPY jetson/models/pretrained_models/gsv-v2final-pretrained/s1bert25hz-5kh-longer-epoch=12-step=369668.ckpt /workspace/GPT-SoVITS/GPT_SoVITS/pretrained_models/gsv-v2final-pretrained/s1bert25hz-5kh-longer-epoch=12-step=369668.ckpt
COPY jetson/models/pretrained_models/gsv-v2final-pretrained/s2G2333k.pth /workspace/GPT-SoVITS/GPT_SoVITS/pretrained_models/gsv-v2final-pretrained/s2G2333k.pth
COPY jetson/models/G2PWModel /workspace/GPT-SoVITS/GPT_SoVITS/text/G2PWModel
COPY jetson/models/nltk_data/corpora/cmudict /usr/local/share/nltk_data/corpora/cmudict
COPY jetson/models/nltk_data/corpora/cmudict.zip /usr/local/share/nltk_data/corpora/cmudict.zip
COPY jetson/models/nltk_data/taggers/averaged_perceptron_tagger /usr/local/share/nltk_data/taggers/averaged_perceptron_tagger
COPY jetson/models/nltk_data/taggers/averaged_perceptron_tagger.zip /usr/local/share/nltk_data/taggers/averaged_perceptron_tagger.zip
COPY jetson/models/nltk_data/taggers/averaged_perceptron_tagger_eng /usr/local/share/nltk_data/taggers/averaged_perceptron_tagger_eng

RUN chmod +x /workspace/GPT-SoVITS/scripts/jetson/entrypoint.sh && \
    mkdir -p /workspace/runtime /workspace/test-results

EXPOSE 9880

ENTRYPOINT ["/workspace/GPT-SoVITS/scripts/jetson/entrypoint.sh"]
CMD ["python3", "api_v2.py", "-a", "0.0.0.0", "-p", "9880"]
